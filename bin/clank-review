#!/bin/bash
# clank-review - Live dashboard of open PRs assigned to me, for reviewing
# Polls gh for PRs where I am the assignee and shows CI status.
# Every non-draft PR not yet in $CLANK_STATE_DIR/reviewed is launched
# automatically, at most one per poll cycle, and recorded before launch.
# Select a PR to (re)launch claude with the clank:review-pr skill.

source "$(dirname "$0")/clank-config"

POLL_INTERVAL=30
FZF_HEADER="Select PR to review"
WINDOW="review"
MAX_WORK_PANES=4
REVIEWED_FILE="$CLANK_STATE_DIR/reviewed"

is_reviewed() {
  [ -f "$REVIEWED_FILE" ] && cut -f1 "$REVIEWED_FILE" | grep -qx "$1"
}

mark_reviewed() {
  mkdir -p "$CLANK_STATE_DIR"
  printf "%s\t%s\t%s\n" "$1" "$2" "$(date -u +%Y-%m-%dT%H:%M:%SZ)" >> "$REVIEWED_FILE"
}

work_pane_count() {
  local panes
  panes=$(tmux list-panes -t "$CLANK_SESSION:$WINDOW" -F '#{pane_id}' 2>/dev/null | wc -l | tr -d ' ')
  echo $(( panes > 0 ? panes - 1 : 0 ))
}

while true; do
  clear
  echo "── Review PRs ──"
  echo ""
  echo "  Fetching PRs assigned to you in $CLANK_GH_REPO..."

  PR_LIST=$(gh pr list --repo "$CLANK_GH_REPO" --state open --assignee @me --limit 100 \
    --json number,title,headRefName,headRefOid,isDraft,reviewDecision,author \
    --jq '.[] | [
      .number,
      .title,
      .headRefName,
      .headRefOid,
      (if .isDraft then "draft" else "-" end),
      (if (.reviewDecision // "") == "" then "-" else .reviewDecision end),
      .author.login
    ] | @tsv' 2>&1)

  if [ -z "$PR_LIST" ] || echo "$PR_LIST" | grep -qi "^error\|failed\|fatal\|forbidden"; then
    clear
    echo "── Review PRs ──"
    echo ""
    if [ -z "$PR_LIST" ]; then
      echo "  No open PRs assigned to you in $CLANK_GH_REPO."
    else
      echo "  Could not list PRs:"
      echo "$PR_LIST" | sed 's/^/    /'
    fi
    echo ""
    echo "  Press Enter to refresh..."
    read -r
    continue
  fi

  QUEUED=""
  while IFS=$'\t' read -r number title branch commit draft review author; do
    [ -z "$number" ] && continue
    [ "$draft" = "draft" ] && continue
    is_reviewed "$number" && continue
    QUEUED="${QUEUED}${number}"$'\t'"${commit}"$'\n'
  done <<< "$PR_LIST"

  if [ -n "$QUEUED" ] && [ "$(work_pane_count)" -lt "$MAX_WORK_PANES" ]; then
    IFS=$'\t' read -r next_number next_commit <<< "$(printf "%s" "$QUEUED" | sort -n | head -1)"
    mark_reviewed "$next_number" "$next_commit"
    clank-launch "$next_number" review
  fi

  QUEUED_COUNT=0
  while IFS=$'\t' read -r number title branch commit draft review author; do
    [ -z "$number" ] && continue
    [ "$draft" = "draft" ] && continue
    is_reviewed "$number" && continue
    QUEUED_COUNT=$((QUEUED_COUNT + 1))
  done <<< "$PR_LIST"

  clear
  echo "── Review PRs ──"
  echo ""
  echo "  Checking CI status..."

  TMPDIR_CI=$(mktemp -d)
  while IFS=$'\t' read -r number title branch commit draft review author; do
    [ -z "$number" ] && continue
    (
      IFS=$'\t' read -r icon ci < <(clank-ci-status "$branch" "$commit")
      case "$review" in
        APPROVED)          review_tag="approved";;
        CHANGES_REQUESTED) review_tag="changes-requested";;
        REVIEW_REQUIRED)   review_tag="needs-review";;
        *)                 review_tag="";;
      esac
      flags=""
      [ "$draft" = "draft" ] && flags="${flags}[draft] "
      [ -n "$review_tag" ] && flags="${flags}[$review_tag] "
      if [ "$draft" != "draft" ] && ! is_reviewed "$number"; then
        flags="${flags}[new] "
      fi
      printf "%s\t%s %-10s #%s %-16s %s%s  (%s)" \
        "$number" "$icon" "$ci" "$number" "$author" "$flags" "$title" "$branch" \
        > "$TMPDIR_CI/$number"
    ) &
  done <<< "$PR_LIST"
  wait

  DISPLAY_LINES=""
  for f in $(ls -r "$TMPDIR_CI"); do
    DISPLAY_LINES="${DISPLAY_LINES}$(cat "$TMPDIR_CI/$f")
"
  done
  rm -rf "$TMPDIR_CI"

  clear
  echo "── Review PRs ──"
  echo ""

  (sleep "$POLL_INTERVAL" && pkill -f "fzf.*$FZF_HEADER" 2>/dev/null) &
  TIMER_PID=$!

  SELECTED=$(echo "$DISPLAY_LINES" \
    | grep -v '^$' \
    | fzf --ansi \
          --delimiter='\t' \
          --with-nth=2 \
          --preview='clank-pr-preview {1}' \
          --preview-window=right:50%:wrap \
          --header="$FZF_HEADER$([ "$QUEUED_COUNT" -gt 0 ] && echo " · $QUEUED_COUNT queued") · Auto-refresh in ${POLL_INTERVAL}s · Ctrl-C to refresh now" \
    | cut -f1)

  kill "$TIMER_PID" 2>/dev/null
  wait "$TIMER_PID" 2>/dev/null

  if [ -n "$SELECTED" ]; then
    selected_commit=$(echo "$PR_LIST" | awk -F'\t' -v n="$SELECTED" '$1 == n { print $4 }')
    is_reviewed "$SELECTED" || mark_reviewed "$SELECTED" "$selected_commit"
    clank-launch "$SELECTED" review
  fi
done
