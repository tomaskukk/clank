#!/bin/bash
# clank-verify - Live PR status dashboard for clank workspace
# Polls all your open PRs via gh CLI and shows CI status.
# Select a PR to launch claude with /verify-pr.
# Must be run from inside a git repo (clank sets cwd to project dir).

source "$(dirname "$0")/clank-config"

POLL_INTERVAL=30

while true; do
  clear
  echo "── Verify PRs ──"
  echo ""
  echo "  Fetching your open PRs..."

  # Get open PRs: number, title, branch, url, commit
  PR_LIST=$(gh pr list --author "@me" --state open \
    --json number,title,headRefName,url,headRefOid \
    --template '{{range .}}{{.number}}	{{.title}}	{{.headRefName}}	{{.url}}	{{.headRefOid}}
{{end}}' 2>&1)

  if [ -z "$PR_LIST" ] || echo "$PR_LIST" | grep -qi "failed\|error\|fatal"; then
    clear
    echo "── Verify PRs ──"
    echo ""
    echo "  No open PRs found for your account."
    echo ""
    echo "  Press Enter to refresh..."
    read -r
    continue
  fi

  clear
  echo "── Verify PRs ──"
  echo ""
  echo "  Checking CI status..."

  # Fetch all CI statuses in parallel
  TMPDIR_CI=$(mktemp -d)
  while IFS=$'\t' read -r number title branch url commit; do
    [ -z "$number" ] && continue
    (
      IFS=$'\t' read -r icon ci < <(clank-ci-status "$branch" "$commit")
      printf "%s\t%s %-10s #%s %s  (%s)" "$number" "$icon" "$ci" "$number" "$title" "$branch" \
        > "$TMPDIR_CI/$number"
    ) &
  done <<< "$PR_LIST"
  wait

  # Collect results
  DISPLAY_LINES=""
  for f in "$TMPDIR_CI"/*; do
    [ -f "$f" ] || continue
    DISPLAY_LINES="${DISPLAY_LINES}$(cat "$f")
"
  done
  rm -rf "$TMPDIR_CI"

  clear
  echo "── Verify PRs ──"
  echo ""

  # Background timer: kill fzf after POLL_INTERVAL to trigger auto-refresh
  (sleep "$POLL_INTERVAL" && pkill -f "fzf.*Select PR to verify" 2>/dev/null) &
  TIMER_PID=$!

  SELECTED=$(echo "$DISPLAY_LINES" \
    | grep -v '^$' \
    | fzf --ansi \
          --delimiter='\t' \
          --with-nth=2 \
          --preview='clank-pr-preview {1}' \
          --preview-window=right:50%:wrap \
          --header="Select PR to verify · Auto-refresh in ${POLL_INTERVAL}s · Ctrl-C to refresh now" \
    | cut -f1)

  # Cancel the background timer (user acted before it fired)
  kill "$TIMER_PID" 2>/dev/null
  wait "$TIMER_PID" 2>/dev/null

  if [ -n "$SELECTED" ]; then
    clank-launch "$SELECTED" verify
  fi
done
